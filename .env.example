# Copia questo file in `.env` e cambia TUTTE le password.
#   cp .env.example .env
# Il file `.env` è in .gitignore e non deve MAI essere committato.

# === Database ===
MYSQL_ROOT_PASSWORD=cambiami-root-password
MYSQL_DATABASE=spese
MYSQL_USER=spese
MYSQL_PASSWORD=cambiami-password

# Host e porta come li vede l'app DENTRO la rete Docker.
# Non toccare se usi docker compose: "db" è il nome del servizio.
MYSQL_HOST=db
MYSQL_PORT=3306

# === App ===
# Porta esposta sulla tua macchina -> http://localhost:8000
APP_PORT=8000

# Password unica per accedere alla dashboard (app single-user).
# Finché resta un valore di esempio l'accesso è BLOCCATO: l'app rifiuta ogni
# login invece di restare aperta a chiunque conosca il repository.
APP_PASSWORD=cambiami-password-app

# Marca il cookie di sessione come `secure`. Va messo a true **solo** dietro
# HTTPS (cioè sulla VPS con un certificato): in locale su http://localhost un
# cookie secure non verrebbe mai inviato e l'accesso sembrerebbe rotto.
COOKIE_SECURE=false

TZ=Europe/Rome
