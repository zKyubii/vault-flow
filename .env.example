# Copy this file to `.env` and change EVERY password.
#   cp .env.example .env
# `.env` is in .gitignore and must NEVER be committed.

# === Database ===
# You never type these: only the containers use them to talk to each other.
# Generate them with:  openssl rand -base64 24
MYSQL_ROOT_PASSWORD=change-me-root-password
MYSQL_DATABASE=spese
MYSQL_USER=spese
MYSQL_PASSWORD=change-me-password

# Host and port as seen by the app INSIDE the Docker network.
# Leave these alone when using docker compose: "db" is the service name.
MYSQL_HOST=db
MYSQL_PORT=3306

# === App ===
# Port published on your machine -> http://localhost:8000
APP_PORT=8000

# The single password for the dashboard (this app is single-user).
# While it is left at an example value sign-in is BLOCKED: the app refuses
# every login rather than being open to anyone who read this repository.
APP_PASSWORD=change-me-app-password

# Marks the session cookie as `secure`. Set this to true **only** behind
# HTTPS (that is, on a server with a certificate): on plain http://localhost
# a secure cookie is never sent and sign-in would appear broken.
COOKIE_SECURE=false

TZ=Europe/Rome
