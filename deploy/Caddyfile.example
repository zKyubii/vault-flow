# Example reverse proxy with Caddy.
#
# Why Caddy and not nginx: it obtains and renews the HTTPS certificate from
# Let's Encrypt on its own, with no certbot and no cron. For a personal app
# that is three lines instead of thirty.
#
# Usage:
#   1. install Caddy on the server
#   2. copy this file to /etc/caddy/Caddyfile and change the domain
#   3. sudo systemctl reload caddy
#
# The domain must already point at the server's IP (an A record), otherwise
# the certificate request fails.
#
# Note: if you reach the app over a private network (Tailscale, WireGuard) you
# do not need any of this — there is no public door to protect.

expenses.example.com {
    encode zstd gzip

    # The app listens on localhost only: from outside you must pass through here.
    reverse_proxy 127.0.0.1:8000

    # Security headers. Not decoration: this app displays a complete list of
    # where you spend your money.
    header {
        # force the browser to use HTTPS for a year
        Strict-Transport-Security "max-age=31536000; includeSubDomains"
        # forbid framing the site elsewhere (clickjacking)
        X-Frame-Options "DENY"
        X-Content-Type-Options "nosniff"
        Referrer-Policy "same-origin"
        # the app loads nothing from external domains: forbidding it makes any
        # injection attempt useless
        Content-Security-Policy "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; connect-src 'self'"
        -Server
    }

    log {
        output file /var/log/caddy/vault-flow.log
    }
}
