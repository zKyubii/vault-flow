# === SECRETS — never commit ===
.env
*.env
!.env.example

# Keys and certificates
*.pem
*.key
*.p12
*.pfx
*.crt

# === BANKING DATA ===
# Bank exports must never end up in a public repository.
# All CSVs are blocked by default: if a test file is needed it goes in
# tests/fixtures/ with invented data.
*.csv
*.xlsx
*.ofx
*.qif
!tests/fixtures/*.csv
uploads/

# === Python ===
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# === Docker / DB ===
db_data/
backups/

# Database dumps contain every transaction: never in the repository.
*.sql
*.sql.gz
# ...but MIGRATIONS are code, not data: they are the database schema, and
# without them the Docker build fails (`COPY db ./db` finds nothing) and
# whoever clones the repo has no way to create the tables.
!db/migrations/
!db/migrations/*.sql

# === WORKING NOTES — DO NOT PUBLISH ===
# CLAUDE.md holds real financial context: account balances, transaction
# tables with dates and amounts, merchant names taken from statements and
# names of real people appearing in transfers. In a public repository all of
# that would be readable by anyone, and third-party data is not ours to
# publish.
#
# The project's public documentation is README.md.
CLAUDE.md

# === Editor / OS ===
.idea/
.vscode/
.DS_Store
Thumbs.db
